# Copy to .env.local.

# --- Supabase (required — the app fails to load without these) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI ---
# Server-side only. Never exposed to the client. Without this set, local dev
# falls back to a deterministic mock analyzer (see README) — production
# (Vercel) always has this set, so it always uses real AI.
OPENAI_API_KEY=
# Optional — defaults to gpt-5.6-terra if unset.
OPENAI_MODEL=

# --- Stripe (Stage 9, pilot pricing test — not wired up yet) ---
STRIPE_SECRET_KEY=
STRIPE_PAYMENT_LINK_URL=
